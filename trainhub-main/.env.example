POSTGRES_USER=trainhub
POSTGRES_PASSWORD=trainhub
POSTGRES_DB=trainhub
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:8888

# Host port the frontend (nginx) is published on. Defaults to 8888 for local
# dev; set to 80 in production so the app is reachable at http://<host>/
FRONTEND_PORT=8888

# S3 bucket for user photos / verification documents. Leave empty for local
# dev (falls back to storing images as base64 in the DB). On EC2 this uses
# the instance's IAM role automatically — no access keys needed.
S3_BUCKET=
AWS_REGION=us-east-1
